# TikSpark Pro production example
#
# Copy this file to .env on your server if you want to manage settings outside
# docker-compose.yml. In 1Panel, you can also paste these as Compose environment
# variables directly.

# SQLite database path inside the container.
TIKSPARK_SQLITE_PATH=/app/backend/data/tikspark.db

# Cookie encryption key path. Back this file up together with tikspark.db.
TIKSPARK_SECRET_KEY_PATH=/app/backend/data/secret.key

# Change this before exposing the service to the internet.
TIKSPARK_ADMIN_TOKEN=replace-with-a-long-random-token

# Keep disabled for first deployment. Turn on after accounts, messages and plans
# are checked in the web UI.
TIKSPARK_SCHEDULER_ENABLED=false

# Scheduler scan interval in seconds.
TIKSPARK_SCHEDULER_SCAN_INTERVAL_SECONDS=60

# Optional safety mode. When true, tasks enter manual-review logs instead of
# sending through browser automation.
TIKSPARK_MANUAL_REVIEW_MODE=false

# Local development CORS. Production usually uses same-origin through port 8010.
TIKSPARK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
